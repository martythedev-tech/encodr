pkgname=encodr
pkgver=0.4.0
pkgrel=1
pkgdesc='Convert video and audio with ffmpeg, with every detail of the job on screen'
url='https://github.com/martythedev-tech/encodr'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'xdg-desktop-portal' 'ffmpeg' 'libnotify')
optdepends=('mediainfo: full technical report in the Source tab')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/encodr "$pkgdir/usr/bin/encodr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/encodr.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/encodr.svg"
  install -Dm644 "$startdir/encodr.desktop" "$pkgdir/usr/share/applications/encodr.desktop"
}
