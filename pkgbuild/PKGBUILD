pkgname=encodr
pkgver=0.6.1
pkgrel=1
pkgdesc='Convert video and audio with ffmpeg, with every detail of the job on screen'
url='https://github.com/martythedev-tech/encodr'
arch=('x86_64' 'aarch64')
license=('MIT')
# The binary needs at least the Qt it was built against ("Qt_6.12 not
# found" otherwise), so pacman upgrades Qt with it or says why it can't.
_qt=$(pacman -Q qt6-base 2>/dev/null | awk '{split($2, v, "."); print v[1] "." v[2]}')
depends=("qt6-base${_qt:+>=$_qt}" 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'xdg-desktop-portal' 'ffmpeg' 'libnotify')
optdepends=('mediainfo: full technical report in the Source tab'
            'vmaf: VMAF in the quality check when ffmpeg has no libvmaf')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/encodr "$pkgdir/usr/bin/encodr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/encodr.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/encodr.svg"
  install -Dm644 "$startdir/encodr.desktop" "$pkgdir/usr/share/applications/encodr.desktop"
}
