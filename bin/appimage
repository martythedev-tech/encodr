#!/bin/sh
# Packs build/encodr into an AppImage that runs on most Linux distributions:
# Qt with its plugins and QML modules, plus a static ffmpeg and ffprobe.
#
# Needs linuxdeploy and its Qt plugin on PATH, QMAKE pointing at the Qt to
# bundle, and FFMPEG_DIR holding an ffmpeg build with bin/ and lib/ (the
# "shared" builds: ffmpeg and ffprobe share one set of libraries, half the
# size of two static programs).
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ARCH="${ARCH:-$(uname -m)}"
VERSION="$(sed -n 's/^pkgver=//p' "$ROOT/pkgbuild/PKGBUILD")"
APPDIR="$ROOT/build/AppDir"
QT_PLUGINS="$("$QMAKE" -query QT_INSTALL_PLUGINS)"

rm -rf "$APPDIR"
mkdir -p "$APPDIR/usr/bin"
mkdir -p "$APPDIR/usr/lib"
install -m755 "$FFMPEG_DIR/bin/ffmpeg" "$FFMPEG_DIR/bin/ffprobe" "$APPDIR/usr/bin/"
cp -a "$FFMPEG_DIR"/lib/lib*.so* "$APPDIR/usr/lib/"
install -Dm644 "$ROOT/LICENSE" "$APPDIR/usr/share/licenses/encodr/LICENSE"
# ffmpeg is GPL; its licence travels with it.
if [ -f "$FFMPEG_DIR/LICENSE.txt" ]; then
    install -Dm644 "$FFMPEG_DIR/LICENSE.txt" "$APPDIR/usr/share/licenses/ffmpeg/LICENSE.txt"
fi

# Wayland as well as X11 (the plugin's file name changed across Qt
# versions), and offscreen for running without a display, as the tests do.
WAYLAND="$(cd "$QT_PLUGINS/platforms" && ls libqwayland*.so libqoffscreen.so 2>/dev/null | tr '\n' ';' | sed 's/;$//')"

export QMAKE
export QML_SOURCES_PATHS="$ROOT/src"
export EXTRA_QT_MODULES="svg"
export EXTRA_PLATFORM_PLUGINS="$WAYLAND"
export LINUXDEPLOY_OUTPUT_VERSION="$VERSION"
export LDAI_OUTPUT="$ROOT/build/Encodr-$VERSION-$ARCH.AppImage"
# ffmpeg's libraries find each other relative to themselves; linuxdeploy
# needs telling where they are.
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

linuxdeploy --appdir "$APPDIR" \
    --executable "$ROOT/build/encodr" \
    --desktop-file "$ROOT/pkgbuild/encodr.desktop" \
    --icon-file "$ROOT/pkgbuild/encodr.svg" \
    --plugin qt

# Encodr always uses the Material style; the other Quick Controls styles
# come along with the module but are never loaded.
for style in Imagine Universal Fusion FluentWinUI3; do
    rm -rf "$APPDIR/usr/qml/QtQuick/Controls/$style"
    rm -f "$APPDIR"/usr/lib/libQt6QuickControls2"$style"*.so*
done

linuxdeploy --appdir "$APPDIR" --output appimage

echo "Built $LDAI_OUTPUT"
