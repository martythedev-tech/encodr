#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

"${QMAKE:-qmake6}" "$ROOT/tests/encodr_tests.pro"
make -j"$(nproc)"
# TEST_WRAPPER runs the suite through something, e.g. tests/under-gdb in CI.
QT_QPA_PLATFORM=offscreen ${TEST_WRAPPER:+"$TEST_WRAPPER"} ./encodr_tests
